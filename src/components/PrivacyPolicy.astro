---
const sections = [
  { id: "information-we-collect", title: "Information we collect" },
  { id: "how-we-use-information", title: "How we use your information" },
  { id: "your-choices", title: "Your choices" },
  { id: "service-providers", title: "Third-party service providers" },
  { id: "third-party-links", title: "Third-party links" },
  { id: "policy-changes", title: "Changes to this policy" },
  { id: "contact-us", title: "Contact us" },
];
---

<div class="bg-[#f7f7f4] px-[max(1.25rem,calc((100vw_-_1240px)/2))] pt-[12rem] text-[#122349] max-[760px]:px-5 max-[760px]:pt-14 max-[760px]:pb-20 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-[#fc784c] [&_a:focus-visible]:outline-offset-4">
  <header class="mx-auto flex max-w-[1240px] items-end justify-between gap-12 pb-[4.5rem] max-[760px]:items-start max-[760px]:flex-col max-[760px]:gap-8 max-[760px]:pb-12">
    <div class="max-w-[720px]">
      <p class="m-0 flex items-center gap-[0.6rem] text-[0.76rem] font-medium uppercase tracking-[0.1em] text-[#687284]">
        <span class="h-[0.55rem] w-[0.55rem] rounded-full bg-black"></span> Your privacy matters
      </p>
      <h1 class="mt-[1.2rem] mb-5 text-[clamp(4rem,9vw,7.5rem)] font-medium leading-[0.9] tracking-[-0.085em] max-[760px]:text-[clamp(4rem,17vw,6.5rem)]">
        Privacy<br /><span class="text-white [-webkit-text-stroke:2px_black]">Policy</span>
      </h1>
      <p class="m-0 max-w-[460px] text-[1.15rem] leading-[1.65] text-[#687284]">
        A straightforward guide to the information we collect, how we use it,
        and the choices available to you.
      </p>
    </div>
    <aside class="flex min-h-[205px] flex-none flex-col items-start justify-between rounded-[0.8rem] bg-black text-white p-[1.35rem] max-[760px]:grid max-[760px]:basis-auto max-[760px]:min-h-0 max-[760px]:w-full max-[760px]:grid-cols-[1fr_auto] max-[760px]:gap-[0.9rem]" aria-label="Policy summary">
      <span class="self-end text-2xl max-[760px]:col-start-2 max-[760px]:row-span-2 max-[760px]:row-start-1" aria-hidden="true">↗</span>
      <p class="m-0 text-[1.35rem] font-medium leading-[1.25]">Clear information.<br />No surprises.</p>
      <span class="text-[0.78rem] max-[760px]:col-start-1">Last updated <time class="mt-1 block font-medium" datetime="2024-08-19">19 Aug 2024</time></span>
    </aside>
  </header>

  <div class="mx-auto grid max-w-[1240px] grid-cols-[235px_minmax(0,1fr)] items-start gap-[clamp(2.5rem,7vw,7rem)] border-t border-[#dedfd9] pt-14 max-[760px]:grid-cols-1 max-[760px]:gap-10 max-[760px]:pt-8">
    <nav class="sticky top-48 py-2 max-[760px]:static max-[760px]:rounded-[0.7rem] max-[760px]:border max-[760px]:border-[#dedfd9] max-[760px]:bg-white max-[760px]:p-[1.2rem]" aria-label="On this page">
      <p class="mb-[1.2rem] text-[0.76rem] font-medium uppercase tracking-[0.1em] text-[#687284]">On this page</p>
      <ol class="m-0 grid list-none gap-[0.15rem] p-0 max-[760px]:grid-cols-2 max-[760px]:gap-x-4 max-[480px]:grid-cols-1">
        {
          sections.map((section, index) => (
            <li>
              <a class="grid grid-cols-[1.7rem_1fr] gap-2 py-[0.55rem] text-[0.87rem] leading-[1.4] text-[#586274] no-underline transition-colors duration-[160ms] hover:text-[#122349] focus-visible:text-[#122349] motion-reduce:transition-none" href={`#${section.id}`}>
                <span class="text-[0.72rem] tabular-nums text-[#9ba1aa]">{String(index + 1).padStart(2, "0")}</span>
                {section.title}
              </a>
            </li>
          ))
        }
      </ol>
      <a class="mt-6 flex items-center justify-between border-t border-[#dedfd9] pt-4 text-[0.83rem] text-[#122349] no-underline max-[760px]:mt-3" href="mailto:team@signlanguagetech.com">
        Have a question? <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <article class="min-w-0 max-w-[780px] text-base leading-[1.8] text-[#586274] [&_a:not(.contact-link)]:text-[#122349] [&_a:not(.contact-link)]:decoration-[#fc784c] [&_a:not(.contact-link)]:[text-underline-offset:0.2em] [&_strong]:font-medium [&_strong]:text-[#122349]">
      <div class="mb-14 grid grid-cols-[2rem_1fr] gap-4 rounded-[0.7rem] bg-white p-[1.4rem] max-[480px]:grid-cols-1 max-[480px]:gap-3 max-[480px]:p-[1.2rem]">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-black text-white text-[0.95rem] font-medium" aria-hidden="true">i</span>
        <p class="m-0 mb-4">
          This Privacy Policy outlines how Sign Language Tech ("we", "our", or "us")
          collects, uses, and protects your information when you visit and interact
          with our website <a href="https://signlanguagetech.com">signlanguagetech.com</a>
          ("Website"). By using the Website, you agree to the terms of this Privacy
          Policy. If you do not agree with these terms, please discontinue use of
          the Website immediately.
        </p>
      </div>

      <section class="mb-[3.25rem] scroll-mt-8" id="information-we-collect">
        <h2 class="mt-0 mb-4 flex items-baseline gap-[0.8rem] text-[clamp(1.3rem,2.5vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.035em] text-[#122349]"><span class="text-[0.78rem] tabular-nums tracking-normal text-black">01</span> Information We Collect</h2>
        <p class="m-0 mb-4">
          When you use our Website, we may collect certain information automatically
          through the use of cookies and similar technologies. This includes:
        </p>
        <ul class="mt-[1.2rem] mb-0 grid gap-[0.85rem] py-0 pl-[1.2rem] [&_li]:pl-[0.35rem] [&_li]:marker:text-black">
          <li>
            <strong>Google Analytics:</strong> We use Google Analytics to track and analyze
            how visitors use our Website. Google Analytics may collect information about
            your browser type, operating system, pages visited, time spent on pages, and
            other similar information. This data is used to improve the functionality and
            user experience of our Website.
          </li>
          <li>
            <strong>YouTube Cookies:</strong> Our Website may embed YouTube videos. When
            you interact with these videos, YouTube may place cookies on your device. These
            cookies may collect information about your interaction with the video content,
            such as viewing history and preferences.
          </li>
        </ul>
      </section>

      <section class="mb-[3.25rem] scroll-mt-8" id="how-we-use-information">
        <h2 class="mt-0 mb-4 flex items-baseline gap-[0.8rem] text-[clamp(1.3rem,2.5vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.035em] text-[#122349]"><span class="text-[0.78rem] tabular-nums tracking-normal text-black">02</span> How We Use Your Information</h2>
        <p class="m-0 mb-4">
          The information collected through Google Analytics and YouTube cookies is used
          for the following purposes:
        </p>
        <ul class="mt-[1.2rem] mb-0 grid gap-[0.85rem] py-0 pl-[1.2rem] [&_li]:pl-[0.35rem] [&_li]:marker:text-black">
          <li>
            <strong>Improving User Experience:</strong> We use the data to understand how
            users interact with our Website, allowing us to make improvements and enhance
            user experience.
          </li>
          <li>
            <strong>Analyzing Trends:</strong> The information helps us analyze trends in
            Website traffic and usage patterns.
          </li>
          <li>
            <strong>Enhancing Content Delivery:</strong> YouTube cookies help us deliver
            relevant video content and improve your interaction with embedded videos.
          </li>
        </ul>
      </section>

      <section class="mb-[3.25rem] scroll-mt-8" id="your-choices">
        <h2 class="mt-0 mb-4 flex items-baseline gap-[0.8rem] text-[clamp(1.3rem,2.5vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.035em] text-[#122349]"><span class="text-[0.78rem] tabular-nums tracking-normal text-black">03</span> Your Choices</h2>
        <p class="m-0 mb-4">
          By continuing to use our Website, you consent to our use of cookies and the
          collection of information as described in this Privacy Policy. If you do not
          agree with these practices, please stop using our Website.
        </p>
        <p class="m-0 mb-4">
          You can also control and manage cookies through your browser settings. Most
          web browsers allow you to view, disable, or delete cookies on your device.
          Please note that disabling cookies may affect the functionality of certain
          features on our Website.
        </p>
      </section>

      <section class="mb-[3.25rem] scroll-mt-8" id="service-providers">
        <h2 class="mt-0 mb-4 flex items-baseline gap-[0.8rem] text-[clamp(1.3rem,2.5vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.035em] text-[#122349]"><span class="text-[0.78rem] tabular-nums tracking-normal text-black">04</span> Third-Party Service Providers</h2>
        <p class="m-0 mb-4">
          We use third-party Service Providers to monitor and analyze the use of our
          Website.
        </p>
        <ul class="mt-[1.2rem] mb-0 grid gap-[0.85rem] py-0 pl-[1.2rem] [&_li]:pl-[0.35rem] [&_li]:marker:text-black">
          <li>
            <strong>Google Analytics:</strong> A web analytics service offered by Google
            that tracks and reports website traffic. For more information on the privacy
            practices of Google, please visit
            <a
              href="https://policies.google.com/privacy?hl=en"
              target="_blank"
              rel="noopener noreferrer"
            >Google Privacy &amp; Terms</a>.
          </li>
          <li>
            <strong>YouTube:</strong> Our Website may embed videos from YouTube, a video
            streaming service provided by Google. When you watch or interact with these embedded
            videos, YouTube may place cookies on your device and collect data regarding your
            interaction with the content. This information may include your viewing history,
            preferences, and other usage statistics, which are used to improve the delivery
            of video content and provide a personalized user experience. You can learn more
            about how YouTube handles your data by visiting their
            <a
              href="https://policies.google.com/privacy"
              target="_blank"
              rel="noopener noreferrer"
            >Privacy Policy</a>.
          </li>
        </ul>
      </section>

      <section class="mb-[3.25rem] scroll-mt-8" id="third-party-links">
        <h2 class="mt-0 mb-4 flex items-baseline gap-[0.8rem] text-[clamp(1.3rem,2.5vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.035em] text-[#122349]"><span class="text-[0.78rem] tabular-nums tracking-normal text-black">05</span> Third-Party Links</h2>
        <p class="m-0 mb-4">
          Our Website may contain links to third-party websites or services, including
          YouTube. Please be aware that we are not responsible for the privacy practices
          of these third parties. We encourage you to review the privacy policies of
          these third-party websites or services before providing any personal
          information or using their services.
        </p>
      </section>

      <section class="mb-[3.25rem] scroll-mt-8" id="policy-changes">
        <h2 class="mt-0 mb-4 flex items-baseline gap-[0.8rem] text-[clamp(1.3rem,2.5vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.035em] text-[#122349]"><span class="text-[0.78rem] tabular-nums tracking-normal text-black">06</span> Changes to This Privacy Policy</h2>
        <p class="m-0 mb-4">
          We may update this Privacy Policy from time to time to reflect changes in our
          practices or for other operational, legal, or regulatory reasons. Any changes
          will be effective immediately upon posting the updated Privacy Policy on our
          Website. We encourage you to review this Privacy Policy periodically to stay
          informed about how we are protecting your information.
        </p>
      </section>

      <section id="contact-us" class="mt-14 mb-6 flex items-center justify-between gap-8 rounded-[0.8rem] bg-black p-8 max-[480px]:items-stretch max-[480px]:flex-col max-[480px]:gap-5 max-[480px]:p-[1.4rem]">
        <div>
          <span class="mb-3 block text-[0.76rem] font-medium uppercase tracking-[0.1em] text-white">We're here to help</span>
          <h2 class="mt-0 mb-[0.7rem] flex items-baseline gap-[0.8rem] text-[clamp(1.3rem,2.5vw,1.7rem)] font-medium leading-[1.25] tracking-[-0.035em] text-white"><span class="text-[0.78rem] tabular-nums tracking-normal text-white">07</span> Contact Us</h2>
          <p class="m-0 max-w-[390px] text-[0.93rem] leading-[1.8] text-[#d2d7e0]">
            If you have any questions or concerns about this Privacy Policy, please contact us.
          </p>
        </div>
        <a class="inline-flex shrink-0 items-center gap-[0.8rem] rounded-[0.4rem] bg-white px-4 py-[0.9rem] text-[0.88rem] font-medium text-black brutal brutal-interactive motion-reduce:transition-none max-[480px]:justify-between max-[480px]:[overflow-wrap:anywhere]" href="mailto:team@signlanguagetech.com">
          team@signlanguagetech.com <span aria-hidden="true">↗</span>
        </a>
      </section>

      <p class="m-0 mt-8 text-[0.88rem] leading-[1.8] text-[#687284]">
        By using our Website, you acknowledge that you have read and understood this
        Privacy Policy and agree to its terms. If you do not agree, please discontinue
        your use of the Website immediately.
      </p>
    </article>
  </div>
</div>
