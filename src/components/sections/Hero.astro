---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import HeroIlust from "../../assets/pics/hero.svg";
---

<Section id="home">
<div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
    <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <div class="text-left space-y-3">
            <h1 class="text-4xl font-medium leading-none md:text-5xl text-center md:text-left">
             Helping Engineering Teams
             <br>Build Better
             <br>Software
            <p class="mt-6 mb-8 text-lg font-normal leading-7 sm:mb-12 text-center md:text-left md:pr-12">
                 Expert-led workshops, consulting, and technical training that improve developer productivity, software quality, and engineering excellence.
            </p>
            <div class="w-full justify-center  items-center md:flex-col gap-4">
                <a href="#" target="_blank" class="px-8 py-5 bg-zinc-900 hover:bg-white rounded-2xl text-center text-white hover:text-black border text-xl font-normal leading-7">
                    Let's Talk
                </a>
                <a href="#" target="_blank" class="px-8 py-5 rounded-2xl text-center text-black border text-xl font-normal leading-7">
                    See How We Help
                </a>
            </div>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <Image src={HeroIlust} alt="Hero Ilustration" loading="eager" />
    </div>
</div>
</Section>