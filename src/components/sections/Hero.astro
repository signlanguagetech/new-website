---
import Section from "./Section.astro";
const youtubeVideoId = "PRChFpeCHu4";
const youtubeEmbedUrl = `https://www.youtube-nocookie.com/embed/${youtubeVideoId}?rel=0&modestbranding=1`;
---

<Section id="home">
    <div class="relative flex flex-col-reverse items-center gap-12 md:flex-row" id="hero">
        <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
            <div class="space-y-6 text-left">
                <h1 class="text-center text-4xl font-medium leading-none md:text-left md:text-5xl">
                    Helping Engineering Teams
                    <br />Build Better
                    <br />Software
                </h1>
                <p class="text-center text-lg font-normal leading-7 md:pr-12 md:text-left">
                    Expert-led workshops, consulting, and technical training that improve developer productivity, software quality, and engineering excellence.
                </p>
                <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row md:justify-start">
                    <a href="#" target="_blank" class="rounded-2xl border bg-zinc-900 px-8 py-5 text-center text-xl font-normal leading-7 text-white hover:bg-white hover:text-black">
                        Let's Talk
                    </a>
                    <a href="#" target="_blank" class="rounded-2xl border px-8 py-5 text-center text-xl font-normal leading-7 text-black hover:bg-zinc-100">
                        See How We Help
                    </a>
                </div>
            </div>
        </div>

        <div class="hidden w-full items-center justify-center py-5 md:flex md:w-6/12 md:pb-20 md:pt-10">
            <div class="group relative aspect-[9/16] w-full max-w-[280px] overflow-hidden rounded-[2rem] border border-black/10 bg-white/70 p-2 shadow-[0_1px_0_rgba(255,255,255,0.65)_inset,0_12px_34px_rgba(15,23,42,0.12)] backdrop-blur-[18px] sm:max-w-[320px] lg:max-w-[360px]">
                <iframe
                    class="h-full w-full rounded-[1.5rem]"
                    src={youtubeEmbedUrl}
                    title="YouTube video player"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy='strict-origin-when-cross-origin'
                    allowfullscreen
                ></iframe>
            </div>
        </div>
    </div>
</Section>
