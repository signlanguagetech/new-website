---
// import PixelStackHero from "@/pages/pixel-stack-hero.astro";
import PixelStackHero from "@/components/sections/PixelStackHero.astro";
import Section from "./Section.astro";
const youtubeVideoId = "PRChFpeCHu4";
const youtubeEmbedUrl = `https://www.youtube-nocookie.com/embed/${youtubeVideoId}?rel=0&modestbranding=1`;
---

<Section id="home" class="relative h-screen w-full">
    <PixelStackHero id="pixel-stack-main" forceStatic={true}>
        <div class="relative mx-auto flex w-full max-w-[1280px] flex-col-reverse items-center gap-12 px-5 md:flex-row pt-48" id="hero">
            <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
                <div class="space-y-6 text-left">
                    <h1 class="text-center text-4xl font-medium leading-none md:text-left md:text-5xl">  
                        Helping Engineering Teams
                        <br />Web Applications
                        <br />Better
                    </h1>
                    <p class="text-center text-lg font-normal leading-7 md:pr-12 md:text-left">
                        Expert-led keynotes, workshops, and technical training that improve developer productivity, software quality, and engineering excellence.
                    </p>
                    <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row md:justify-start">
                        <a href="#" target="_blank" class="brutal brutal-interactive bg-white font-normal text-black hover:bg-white/85">
                            Let's Talk
                        </a>
                        <a href="#" target="_blank" class="brutal brutal-interactive bg-white/60 font-normal text-black hover:bg-white/90">
                            See How We Help
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </PixelStackHero>
</Section>
