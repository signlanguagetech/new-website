---
import { Image } from 'astro:assets';
import Card from '../ui/Card.astro';
import Section from './Section.astro';
---

<Section>
  <Card>
    <div class="flex bg-[#F3F3F3] rounded-[45px] p-[60px] relative mt-[123px] mb-[163px]">
      <div class="w-full md:w-[50%] flex flex-col gap-[26px]">
        <h2 class="text-3xl font-medium">Ready to engineer your next breakthrough?</h2>
        <p>
          Reach out today to learn how a tailored keynote, workshop, or training program can elevate your engineering
          culture. Tell us about your goals, and we'll craft a proposal designed around the exact outcomes you want to
          achieve.
        </p>
        <button class="btn-primary w-fit">Request a custom proposal</button>
      </div>
    </div>
  </Card>
</Section>
