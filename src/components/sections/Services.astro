---
import SectionTitle from "../ui/SectionTitle.astro";
import Section from "./Section.astro";
import AccordionItem from "../ui/AccordionItem.astro";

const cards = [
  {
    index: 1,
    title: "Keynotes",
    description: "Keynote speaker presenting transformative ideas to a engineering audience",
    link: "/services/keynotes",
  },
  {
    index: 2,
    title: "Workshops",
    description: "Team members collaborating during an interactive professional workshop",
    link: "/services/workshops",
  },
  {
    index: 3,
    title: "Training",
    description: "Technical training sessions designed to enhance the skills and knowledge of engineering teams",
    link: "/services/training",
  }
];

const description = `Great engineering requires more than technical prowess; it demands visionary thinking, seamless collaboration, and continuous mastery. From the spark of a keynote to the synergy of a workshop and the rigor of targeted training, we architect experiences that transform how your teams build the future.`
---

<Section id="services">
  <div class="mt-[140px] mb-5">
    <SectionTitle sectionTitle="Services" description={description} />
    {cards.map(card => (
      <AccordionItem
        index={card.index}
        title={card.title}
        description={card.description}
        link={card.link}
      />
    ))
    }
  </div>
</Section>
