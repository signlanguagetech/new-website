---
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../ui/ServiceCard.astro";
import Section from "./Section.astro";

import c1 from "../../assets/pics/card-pic1.png";
import c2 from "../../assets/pics/card-pic2.png";
import c3 from "../../assets/pics/card-pic3.png";

const cards = [
  {
    index: 1,
    titleTop: "Inspire new",
    titleBottom: "possibilities",
    img: c1,
    alt: "Keynote speaker presenting transformative ideas to a business audience",
    link: "/services/keynotes",
  },
  {
    index: 2,
    titleTop: "Turn ideas into",
    titleBottom: "action",
    img: c2,
    alt: "Team members collaborating during an interactive professional workshop",
    link: "/services/workshops",
  },
  {
    index: 3,
    titleTop: "Create lasting",
    titleBottom: "impact",
    img: c3,
    alt: "Consultant working with business leaders on strategy and organizational change",
    link: "/services/consulting",
  }
];

const description = `Whether you want to inspire an audience, equip a team, 
or solve a complex organizational challenge, 
each engagement is designed around your context and the outcomes you want to achieve.`
---

<Section id="services">
  <div class="mt-[140px] mb-5">
    <SectionTitle sectionTitle="Services" description={description} />
    <div class="grid lg:grid-cols-2 lg:grid-rows-3 gap-10">
      {
        cards.map((card) => (
          <ServiceCard
            index={card.index}
            titleTop={card.titleTop}
            titleBottom={card.titleBottom}
            img={card.img}
            alt={card.alt}
            link={card.link}
          />
        ))
      }
    </div>
  </div>
</Section>
