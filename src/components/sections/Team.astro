---
import SectionTitle from "../ui/SectionTitle.astro";
import TeamCard from "../ui/TeamCard.astro";
import Section from "./Section.astro";

const description =
  "Meet the skilled and experienced team behind our successful digital marketing strategies";

// Team images
import p1 from "../../assets/team/t1.png";
import p2 from "../../assets/team/t2.png";
import p3 from "../../assets/team/t3.png";
import p4 from "../../assets/team/t4.png";
import p5 from "../../assets/team/t5.png";
import p6 from "../../assets/team/t6.png";

const team = [
  {
    pic: p1,
    name: "Milad Vafaeifard",
    role: "CEO & Founder, Software Engineer",
    description:
      "An experienced Software Engineer with over 13+ years in web services, I've been working on countless projects, each presenting its unique potentials and challenges. Every challenge overcome has enriched my knowledge base and fine-tuned my expertise. My journey thus far has fueled my desire to share my accumulated wealth of knowledge, and that's why this Sign Language Tech was born into here.",
    link: "https://www.linkedin.com/in/miladvafaeifard/",
  },  
  {
    pic: p2,
    name: "Andres Garcia",
    role: "Tech Lead & Software Engineer",
    description:
      "A Software Engineer from Colombia with over 7 years of experience. My journey in tech has been driven by a passion for building useful products and a deep curiosity for how things work, from mobile apps to AI. My main focus is Flutter, but I also have a strong background in full-stack development. As a Deaf professional, I'm also dedicated to making technology more accessible for everyone. This led me to contribute to the tech community as an open-source maintainer, a speaker at events like Google I/O Extended, and the Tech Lead for the 'Sign Language Tech' initiative.",
    link: "https://www.linkedin.com/in/techandgar/",
  }
];
---

<Section id="about">
  <div class="mt-[140px]">
    <SectionTitle sectionTitle="Team" description={description} />
    <div
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 grid-rows-2 gap-10"
    >
      {
        team.map((member, index) => (
          <TeamCard
            key={index}
            pic={member.pic}
            name={member.name}
            role={member.role}
            description={member.description}
            link={member.link}
          />
        ))
      }
    </div>
  </div>
</Section>
