---
import SectionTitle from "../ui/SectionTitle.astro";
import Carousel from "../ui/Carousel.astro";
import Section from "./Section.astro";
---

<Section id="testimonials">
  <div class="mt-20">
    <SectionTitle
      sectionTitle="Testimonials"
      description="Hear from Our Satisfied Clients: Read Our Testimonials to Learn More about Our Software Engineering Services"
    />
    <div class="rounded-[45px] text-white mb-[150px] border border-dark">
      <Carousel />
    </div>
  </div>
</Section>
