---
import siteData from "../../data/siteData.json";
import jsonLDGenerator from "../../utils/jsonLD";

type Props = {
  title: string;
  description: string;
  url: string;
  image?: { src: string; alt: string };
  robots?: boolean;
  frontmatter?: {
    title: string;
    description: string;
    image: string;
    author: string;
    date: string;
  };
};

const {
  title,
  description,
  url = Astro.url.toString(),
  image,
  frontmatter,
  robots,
} = Astro.props;

const jsonLD = frontmatter
  ? jsonLDGenerator({ type: "post", post: frontmatter, url })
  : jsonLDGenerator({ type: "website", url });
const imageSrc = new URL(image?.src || siteData.image.src, import.meta.env.SITE).toString();
const imageAlt = image?.alt || siteData.image.alt;
---

<!-- SEO -->
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:site_name" content={siteData.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageSrc} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={imageSrc} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Using environment domain -->
<meta name="twitter:domain" content={import.meta.env.SITE} />

{robots && <meta name="robots" content="noindex, nofollow" />}

<!-- JSON LD -->
<Fragment set:html={jsonLD} />
