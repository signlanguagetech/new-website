---
import { Image } from "astro:assets";
import Facebook from "../../assets/facebook.svg";
import Github from "../../assets/github.svg";
import Linkedin from "../../assets/linkedin.svg";
import SltIcon from "../icons/SltIcon.astro";
import ShortForm from "../ui/ShortForm.astro";

const logos = [
  { name: "YouTube", src: Facebook, link: "https://facebook.com" },
  { name: "Linkedin", src: Linkedin, link: "https://linkedin.com" },
  { name: "Github", src: Github, link: "https://github.com" },
];

const links = [
  { name: "About us", href: "/about" },
  { name: "Services", href: "/services" },
  { name: "Blog", href: "/blog" },
];
---

<section class="sm:px-5">
  <div class="w-full max-w-[1240px] mx-auto">
    <div class="px-[15px] bg-dark text-gray py-[55px] lg:px-[60px] sm:rounded-t-[45px]">
      <div>
        <div class="flex flex-col lg:flex-row gap-7 items-center justify-between">
          <picture>
            <a href="#home" class="inline-flex items-center">
              <SltIcon height="32px" width="32px" dark={true} />
              <span class="slt-text">Sign Language Tech</span>
            </a>
          </picture>
          <ul class="flex flex-col sm:flex-row gap-5">
            {
              links.map((link) => {
                return (
                  <li class="text-center">
                    <a class="underline" href={link.href}>
                      {link.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <ul class="flex gap-5">
            {
              logos.map((logo) => {
                return (
                  <li>
                    <a href={logo.link} target="_blank">
                      <picture>
                        <Image src={logo.src} alt={logo.name} />
                      </picture>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
        <div class="flex flex-col lg:flex-row mt-[66px] mb-[51px]">
          <div class="flex text-center lg:text-start flex-col w-full lg:w-[30%]">
            <h3 class="mb-5 text-center md:text-left text-2xl text-green">Contact us</h3>
            <div class="flex flex-col justify-between gap-4">
              <span> Email: team@signlanguagetech.com </span>
              <span class="lg:w-3/4">
                Address: Budapest, Hungary
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="h-[1px] bg-gray mb-5"></div>
      <div class="flex flex-col lg:flex-row h-20 justify-center mt-4 text-center md:justify-between md:mt-0">
        <span>© 2026 Sign Language Tech</span>
        <span>All rights reserved.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .slt-text {
    padding: 0 10px;
    font-weight: 600;
  }
</style>