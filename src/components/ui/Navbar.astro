---
import SltIcon from "../icons/SltIcon.astro";

const menuitems = [
  { href: '/about', label: 'About', number: '01' },
  { href: '/services', label: 'Services', number: '02' },
  { href: '/blog', label: 'Blog', number: '04' },
];
---

<div class="navbar-spacer">
  <nav id="site-navbar" class="navbar-wrap fixed top-0 left-0 z-50 w-full px-2.5 pt-2 md:px-6 md:pt-4 lg:px-8">
    <header id="navbar-shell" class="navbar-shell mx-auto flex max-w-7xl items-center justify-between rounded-full border border-transparent px-4 py-2.5 transition-all duration-300 ease-out md:bg-white/95 md:px-5 md:py-3.5 lg:px-8 lg:py-4">
      <a href="/" class="flex min-w-0 items-center gap-3 rtl:space-x-reverse" data-close-menu="true">
        <SltIcon height="32px" width="32px" />
        <span class="slt-text">Sign Language Tech</span>
      </a>

      <!-- Desktop navigation links -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Main Navigation">
        {menuitems.map((item) => (
          <a
            href={item.href}
            class="text-base font-medium text-black transition hover:text-black/70"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA button -->
      <div class="hidden lg:flex items-center gap-4">
        <a href="/contact" class="btn-primary inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold">
          contact
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Mobile Right Control -->
      <div class="flex shrink-0 items-center lg:hidden">
        <!-- Menu toggle button -->
        <button
          id="menu-icon"
          type="button"
          class="mobile-control-button flex h-12 w-12 items-center justify-center rounded-full border border-black/10 bg-white text-black transition hover:bg-black/5 active:scale-95"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <!-- Hamburger icon -->
          <svg
            id="open-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
          >
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
          <!-- Close X icon -->
          <svg
            id="close-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden h-5 w-5"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>
  </nav>

  <!-- Mobile Fullscreen Menu Overlay -->
  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-0 z-40 flex flex-col bg-[#F7F7F8] px-[22px] pt-[7.65rem] pb-8 overflow-y-auto lg:hidden"
    data-lenis-prevent
    aria-modal="true"
    role="dialog"
  >
    <div class="mx-auto w-full max-w-lg">
      <!-- Divider above first item -->
      <div class="border-t border-[#d8d8d3]"></div>

      <!-- Menu items list -->
      <nav aria-label="Mobile Navigation">
        <ul class="flex flex-col">
          {menuitems.map((item) => (
            <li class="border-b border-[#d8d8d3]">
              <a
                href={item.href}
                class="mobile-nav-link group flex items-center gap-4 py-[1.05rem] transition-colors sm:py-5"
                data-close-menu="true"
              >
                <span class="w-5 shrink-0 text-xs font-extrabold tracking-wider text-black/55 transition-colors group-hover:text-black">
                  {item.number}
                </span>
                <span class="mobile-menu-label text-[2.7rem] font-extrabold tracking-[-0.08em] text-black transition-transform duration-200 group-hover:translate-x-1 leading-[0.98] sm:text-5xl">
                  {item.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</div>

<script is:inline>
  const navbar = document.getElementById('site-navbar');
  const navbarShell = document.getElementById('navbar-shell');
  const menuIcon = document.getElementById('menu-icon');
  const openIcon = document.getElementById('open-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileMenu = document.getElementById('mobile-menu');
  const closeMenuItems = document.querySelectorAll('[data-close-menu="true"]');

  const updateNavbarState = () => {
    const isScrolled = window.scrollY > 24;
    navbar?.classList.toggle('navbar-scrolled', isScrolled);
    navbarShell?.classList.toggle('navbar-shell-scrolled', isScrolled);
  };

  const openMobileMenu = () => {
    mobileMenu?.classList.add('menu-open');
    openIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    menuIcon?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-locked');
  };

  const closeMobileMenu = () => {
    mobileMenu?.classList.remove('menu-open');
    openIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    menuIcon?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-locked');
  };

  menuIcon?.addEventListener('click', () => {
    const isExpanded = menuIcon.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  closeMenuItems.forEach((item) => {
    item.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.classList.contains('menu-open')) {
      closeMobileMenu();
      menuIcon?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      closeMobileMenu();
    }
  });

  window.addEventListener('scroll', updateNavbarState, { passive: true });
  updateNavbarState();
</script>

<style>
  .navbar-spacer {
    /* min-height: 5.75rem; */
  }

  .navbar-wrap {
    transition: padding 0.3s ease;
  }

  .navbar-shell {
    box-shadow: none;
    backdrop-filter: blur(12px);
  }

  .navbar-scrolled {
    padding-top: 0.75rem;
  }

  .navbar-shell-scrolled {
    /* max-width: 78rem; */
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.65) inset, 0 12px 34px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(40px);
    background-color: rgba(255, 255, 255, 0.2);
  }

  .slt-text {
    padding: 0 6px;
    font-weight: 800;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .mobile-control-button {
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
  }

  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .mobile-menu.menu-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  :global(body.menu-locked) {
    overflow: hidden;
  }

  @media (max-width: 1023px) {
    .navbar-spacer {
      min-height: 5.35rem;
    }
  }

  @media (max-width: 420px) {
    .slt-text {
      max-width: 9.5rem;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mobile-menu-label {
      font-size: clamp(2.25rem, 11.5vw, 2.7rem);
    }
  }
</style>