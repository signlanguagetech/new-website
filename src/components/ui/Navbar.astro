---
import { Astronav } from "astro-navbar";
import SltIcon from "../icons/SltIcon.astro";

const menuitems = [
  { href: '/about', label: 'About us' },
  { href: '/services', label: 'Services' },
  { href: '/#cases', label: 'Use Cases' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/articles', label: 'Blog' },
];
---

<div class="navbar-spacer">
  <nav id="site-navbar" class="navbar-wrap fixed top-0 left-0 z-50 w-full px-4 pt-4 md:px-6 lg:px-8">
    <header id="navbar-shell" class="navbar-shell mx-auto flex max-w-7xl flex-col justify-between gap-4 rounded-[2rem] border border-transparent bg-white/95 px-6 py-4 transition-all duration-300 ease-out lg:flex-row lg:items-center lg:px-8">
      <Astronav class="w-full">
        <div class="flex w-full items-center justify-between gap-4 lg:w-auto">
          <a href="/" class="flex items-center gap-3 rtl:space-x-reverse">
            <SltIcon height="32px" width="32px" />
            <span class="slt-text">Sign Language Tech</span>
          </a>

          <div class="block lg:hidden">
            <button id="menu-icon" type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-black/10 text-black transition hover:bg-black/5" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="menu-items">
              <svg id="open-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-6 w-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
              <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="hidden h-6 w-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <div id="menu-items" class="hidden w-full lg:mt-0 lg:block lg:w-auto">
          <ul class="mt-4 flex flex-col rounded-3xl border border-black/10 bg-white p-4 text-base font-medium shadow-[0_12px_40px_rgba(0,0,0,0.08)] lg:mt-0 lg:flex-row lg:items-center lg:gap-8 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none">
            {menuitems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="mobile-nav-link block rounded-full px-3 py-2 text-black transition hover:bg-black hover:text-white lg:px-0 lg:py-0 lg:hover:bg-transparent lg:hover:text-black/70"
                  data-close-menu="true"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Astronav>

      <div class="hidden lg:flex items-center gap-4">
        <a href="/contact" class="btn-primary inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold">
          Start a project
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </header>
  </nav>
</div>

<script is:inline>
  const navbar = document.getElementById('site-navbar');
  const navbarShell = document.getElementById('navbar-shell');
  const menuIcon = document.getElementById('menu-icon');
  const openIcon = document.getElementById('open-icon');
  const closeIcon = document.getElementById('close-icon');
  const menuItems = document.getElementById('menu-items');
  const closeMenuItems = document.querySelectorAll('[data-close-menu="true"]');

  const updateNavbarState = () => {
    const isScrolled = window.scrollY > 24;
    navbar?.classList.toggle('navbar-scrolled', isScrolled);
    navbarShell?.classList.toggle('navbar-shell-scrolled', isScrolled);
  };

  const closeMobileMenu = () => {
    menuItems?.classList.add('hidden');
    openIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    menuIcon?.setAttribute('aria-expanded', 'false');
  };

  menuIcon?.addEventListener('click', () => {
    menuItems?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');

    const isExpanded = menuIcon.getAttribute('aria-expanded') === 'true';
    menuIcon.setAttribute('aria-expanded', String(!isExpanded));
  });

  closeMenuItems.forEach((item) => {
    item.addEventListener('click', closeMobileMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menuItems?.classList.contains('hidden')) {
      closeMobileMenu();
      menuIcon?.focus();
    }
  });

  window.addEventListener('scroll', updateNavbarState, { passive: true });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      closeMobileMenu();
    }
  });

  updateNavbarState();
</script>

<style>
  .navbar-spacer {
    min-height: 7rem;
  }

  .navbar-wrap {
    transition: padding 0.3s ease;
  }

  .navbar-shell {
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
  }

  .navbar-scrolled {
    padding-top: 0.75rem;
  }

  .navbar-shell-scrolled {
    max-width: 78rem;
    border-color: rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(18px);
  }

  .slt-text {
    padding: 0 10px;
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    .navbar-spacer {
      min-height: 5.75rem;
    }
  }
</style>