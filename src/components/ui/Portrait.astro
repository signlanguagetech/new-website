---
import { Image } from "astro:assets";

interface Props {
  srcClear: ImageMetadata
  srcPixel: ImageMetadata
  widthStage: number
  alt: string
  sizes?: string
  class?: string
  loading?: 'lazy' | 'eager';
}

const {
  srcClear,
  srcPixel,
  alt,
  widthStage = 300,
  sizes = '(min-width: 768px) 480px, 90vw',
  loading = 'lazy',
  class: className
} = Astro.props;

---

<div class:list={['portrait-stage', className]} tabindex="0">
  <div class="bg-[#F3F3F3] portrait" aria-hidden="true"></div>
  <div class="portrait-cutouts">
    <Image
      class="portrait-cutout is-clear"
      src={srcClear}
      alt={alt}
      width={widthStage}
      widths={[380, 760, 1140]}
      sizes={sizes}
      loading={loading}
    />
    <Image
      class="portrait-cutout is-pixel"
      src={srcPixel}
      alt={alt}
      width={widthStage}
      widths={[380, 760, 1140]}
      sizes={sizes}
      loading={loading}
      aria-hidden="true"
    />
  </div>
</div>

<script>
  import { animate } from "motion";

  const clearPose = [
    { opacity: 0, filter: "blur(6px)", scale: 1.04 },
    { opacity: 1, filter: "blur(0px)", scale: 1 },
  ];
  const pixelPose = [
    { opacity: 1, filter: "blur(2px)" },
    { opacity: 0, filter: "blur(8px)" },
  ];
  const fade = { duration: 0.6, ease: "easeOut" } as const;
  const frameSpring = { type: "spring", stiffness: 260, damping: 20 } as const;
  const instant = { duration: 0 };
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".portrait-stage").forEach((stage) => {
    const frame = stage.querySelector<HTMLElement>(".portrait")!;
    const cutouts = stage.querySelector<HTMLElement>(".portrait-cutouts")!;
    const clear = stage.querySelector<HTMLElement>(".is-clear")!;
    const pixel = stage.querySelector<HTMLElement>(".is-pixel")!;

    stage.dataset.motion = "";
    animate(clear, clearPose[0], instant);
    animate(pixel, pixelPose[0], instant);

    let controls: { stop: () => void }[] = [];
    let active = false;

    const toggle = (next: boolean) => {
      if (next === active) return;
      active = next;
      controls.forEach((c) => c.stop());

      const i = next ? 1 : 0;
      const fadeOptions = reduceMotion ? instant : fade;
      const springOptions = reduceMotion ? instant : frameSpring;

      controls = [
        animate(clear, clearPose[i], fadeOptions),
        animate(pixel, pixelPose[i], fadeOptions),
        animate(frame, { rotate: next ? -1 : 0 }, springOptions),
        animate(cutouts, { scale: next ? 1.02 : 1 }, springOptions),
      ];
    };

    stage.addEventListener("pointerenter", (e) => e.pointerType !== "touch" && toggle(true));
    stage.addEventListener("pointerleave", (e) => e.pointerType !== "touch" && toggle(false));
    stage.addEventListener("pointerdown", (e) => e.pointerType === "touch" && toggle(!active));
    stage.addEventListener("focusin", () => toggle(true));
    stage.addEventListener("focusout", () => toggle(false));
  });
</script>


<style>

  .portrait-stage {
    display: grid;
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 480px;
  }

  .portrait-cutouts {
    display: grid;
  }

  .portrait-cutout {
    grid-area: 1 / 1;
  }

  .portrait {
    position: absolute;
    inset: 30% 1.7% 0.7% 8%;
    z-index: -1;
    border: 2px solid black;
    border-radius: 20px;
    background-image: radial-gradient(black 0.2px, transparent 0.5px);
    background-size: 22px 22px;
    background-position: center;
  }

  .portrait-stage :global(.portrait-cutout) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .portrait-stage {
    outline: none;
  }

  .is-clear {
    opacity: 0;
  }

  .is-pixel {
    opacity: 1;
    filter: blur(2px);
  }

  /* No-JS fallback; Motion drives everything once data-motion is set */
  .portrait-stage:not([data-motion]):hover .is-pixel {
    opacity: 0;
  }

  .portrait-stage:not([data-motion]):hover .is-clear {
    opacity: 1;
  }
</style>