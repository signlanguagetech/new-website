---
import { Image } from "astro:assets";
import Card from "./Card.astro";

import gob from "../../assets/icon6.svg";
import wob from "../../assets/icon7.svg";

/* 
1. Gray card with green title and green on black icon 
2. Green card with gray title and green on black icon
3. Black card with gray title and gray on black icon
*/

const { index, title, description, img, alt, link } = Astro.props;
---

<Card isUnderline={true}>
  <div
    class=`h-[300px] w-full sm:h-full lg:gap-[60px] grid custom-grid lg:grid-cols-2 lg:grid-rows-1 p-8 sm:p-[50px] rounded-[45px]`
  >
    <h3 class=`flex flex-col col-span-2 lg:col-span-1`>
      <span class="w-[fit-content]"
        >{title}</span
      >
      <span class="w-[fit-content]"
        >{description}</span
      >
    </h3>
    <div class="flex">
      <a href={link} class="flex items-center gap-3.5"
        ><Image src={gob} alt={alt} />
        <span>Service Info</span></a
      >
    </div>
  </div>
</Card>

<style>
  .custom-grid {
    grid-template: auto auto;
  }
</style>
