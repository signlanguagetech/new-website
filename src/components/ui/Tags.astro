---
import { capitalize } from '../../utils';
interface Props {
  href: string;
  tags: string[];
}

const { tags, href } = Astro.props;

---
<div class="flex flex-wrap gap-2">
  {tags.map((tag: string) => (
   <span
   class="px-2 py-1 bg-lime text-black rounded-full text-xs hover:opacity-90"
   ><a href={`/${href}/tag/${tag}`}>#{capitalize(tag)}</a></span>
  ))}
 </div>
 