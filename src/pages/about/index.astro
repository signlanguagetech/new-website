---
import MainLayout from "@/layouts/MainLayout.astro";
import Services from "@/components/sections/Services.astro";
import Team from "@/components/sections/Team.astro";
import Proposal from "@/components/sections/Proposal.astro";
---

<MainLayout title="About us">
    <div class="pt-48 px-4 mx-auto max-w-screen-xl lg:px-6">
        <div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
            <div class="row items-center md:pb-20">
                <div class="space-y-10">
                    <h2 class="text-5xl font-medium leading-none md:text-6xl">Making web development more accessible in sign language</h2>
                    <p class="mt-6 mb-8 text-xl font-normal leading-7 sm:mb-12">We share practical web development and software engineering knowledge through keynotes, hands-on workshops, and training, with Deaf learners and sign-language access at the heart of our work.</p>
                    <a class="brutal brutal-interactive border-2 border-white inline-flex items-center justify-center gap-3 bg-black font-medium text-white" href="/contact">
                        Talk with our team
                    </a>
                </div>
            </div>
        </div>
    </div>
    <Team />
    <section id="why-sign-language-tech" class="px-5 py-16">
        <div class="mx-auto grid w-full max-w-[1280px] gap-14 md:grid-cols-2 md:gap-16">
            <article>
                <h2 class="mb-6 text-3xl font-medium leading-tight sm:text-4xl">Why Sign Language Tech?</h2>
                <p class="text-lg leading-8">
                    Web development shapes how we communicate, work, and access services, yet technical knowledge is not always shared in ways that include Deaf people. Sign Language Tech makes professional web and software engineering insights more accessible through International Sign and American Sign Language (ASL). We want Deaf learners and professionals to engage directly with the ideas, and Deaf experts to share the experience and perspectives that enrich our industry.
                </p>
            </article>
            <article>
                <h2 class="mb-6 text-3xl font-medium leading-tight sm:text-4xl">Interactive Learning Opportunities</h2>
                <p class="text-lg leading-8">
                    Learning goes beyond tutorials and interviews. We’re working toward interactive events where experts can present, answer questions, and lead practical workshops. These experiences are designed to support career growth, strengthen community, and help participants build web development skills through hands-on learning—with sign-language access in focus.
                </p>
            </article>
        </div>
    </section>
    <Services />
</MainLayout>