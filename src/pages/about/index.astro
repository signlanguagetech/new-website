---
import MainLayout from "@/layouts/MainLayout.astro";
import Services from "@/components/sections/Services.astro";
import Team from "@/components/sections/Team.astro";
import Proposal from "@/components/sections/Proposal.astro";
---

<MainLayout title="About us">
    <div class="pt-48 px-4 mx-auto max-w-screen-xl lg:px-6">
        <div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
            <div class="row items-center md:pb-20">
                <div class="space-y-10">
                    <h2 class="text-5xl font-medium leading-none md:text-6xl">Helping engineering teams build better web applications</h2>
                    <p class="mt-6 mb-8  text-xl font-normal leading-7 sm:mb-12">We share practical engineering experience through technical keynotes, hands-on workshops, and structured training—helping developers and teams strengthen their skills and build with confidence.</p>
                    <a class="brutal brutal-interactive border-2 border-white inline-flex items-center justify-center gap-3 bg-black font-medium text-white" href="/contact">
                        Talk with our team
                    </a>
                </div>
            </div>
        </div>
    </div>
    <Team />
    <Services />
</MainLayout>