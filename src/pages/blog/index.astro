---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ArticleCard from "../../components/ui/ArticleCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MainLayout
  title="Software Engineering & Accessibility Blog | Sign Language Tech"
  description="Stories and practical insights on software engineering, sign language, accessibility, and inclusive technology from Sign Language Tech."
>
  <main class="mb-40 pt-24">
    <section class="mx-auto max-w-screen-xl px-4 py-8 lg:px-3 lg:py-16">
      <header class="mx-auto mb-12 max-w-screen-sm text-center">
        <h1 class="mb-4 text-3xl font-extrabold tracking-tight lg:text-4xl">Our Blog</h1>
        <p class="font-light sm:text-xl">
          Ideas, updates, and practical insights from Sign Language Tech.
        </p>
      </header>
      <div class="grid gap-8 lg:grid-cols-2">
        {posts.map((post) => <ArticleCard article={post} hrefBase="/blog" />)}
      </div>
    </section>
  </main>
</MainLayout>