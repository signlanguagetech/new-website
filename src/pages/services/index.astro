---
import MainLayout from '@/layouts/MainLayout.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Card from '@/components/ui/Card.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import c1 from '@/assets/pics/card-pic1.png';
import c2 from '@/assets/pics/card-pic2.png';
import c3 from '@/assets/pics/card-pic3.png';
import c4 from '@/assets/pics/card-pic4.png';
import c5 from '@/assets/pics/card-pic5.png';
import c6 from '@/assets/pics/card-pic6.png';

type Service = DeepReadonly<{
  index: number;
  titleTop: string;
  titleBottom: string;
  img: ImageMetadata;
  alt: string;
  description: string;
  benefits: string[];
  cta: string;
  link: string;
}>;

const services: readonly Service[] = [
  {
    index: 1,
    titleTop: 'Keynotes',
    titleBottom: '',
    img: c1,
    alt: '',
    description: '',
    benefits: [],
    cta: '',
    link: '/services/keynotes',
  },
  {
    index: 2,
    titleTop: 'Workshops',
    titleBottom: '',
    img: c2,
    alt: '',
    description: '',
    benefits: [''],
    cta: '',
    link: '/services/workshops',
  },
  {
    index: 3,
    titleTop: 'Consulting',
    titleBottom: '',
    img: c3,
    alt: '',
    description: '',
    benefits: [''],
    cta: '',
    link: '/services/consulting',
  },
];
---

<MainLayout
  title="Our Services"
  description="Explore our comprehensive range of digital marketing services designed to help your business thrive in the online world. From keynotes to workshops and consulting, we provide tailored solutions to meet your unique needs."
>
  <div class="pt-48 px-4 mx-auto max-w-screen-xl lg:px-6">
    <div class="mb-16">
      <h1 class="mb-4 text-5xl font-medium leading-none tracking-tight md:text-6xl">Our Services</h1>
      <p class="text-xl font-normal leading-7 max-w-3xl">
        <p class="text-xl font-normal leading-7 max-w-3xl">
          Helping teams and developers build better web applications through practical workshops, technical keynotes,
          and software engineering consulting. Whether you're looking to upskill your team, improve your 
          architecture, or bring expert insights to your event, we provide tailored solutions backed by real-world
          engineering experience.
        </p>
      </p>
    </div>

    <div class="space-y-24">
      {
        services.map((service, index) => (
          <div class="service-item">
            <div class="mb-12">
              <ServiceCard
                index={service.index}
                titleTop={service.titleTop}
                titleBottom={service.titleBottom}
                img={service.img}
                alt={service.alt}
                link={service.link}
              />
            </div>

            <div class="grid md:grid-cols-2 gap-10 px-4">
              <div>
                <h3 class="text-2xl font-medium mb-4">What we offer</h3>
                <p class="mb-6">{service.description}</p>
                <a
                  href={service.link}
                  class="inline-flex items-center px-8 py-4 bg-green text-dark rounded-2xl hover:bg-dark hover:text-white transition-all font-medium"
                >
                  {service.cta}
                  <svg
                    class="ml-2 w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </a>
              </div>

              <div class="bg-gray rounded-2xl p-8">
                <h3 class="text-2xl font-medium mb-4">Benefits</h3>
                <ul class="space-y-4">
                  {service.benefits.map(benefit => (
                    <li class="flex items-start">
                      <svg
                        class="mr-2 w-5 h-5 mt-1 text-green"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      <span>{benefit}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-24">
      <Card>
        <div class="p-10 md:p-16">
          <h2 class="text-3xl md:text-4xl font-medium mb-6">Learn from engineers who build, lead, and innovate</h2>
          <p class="mb-10 text-xl max-w-2xl">
           We combine deep technical expertise with real-world experience to deliver impactful keynotes, practical workshops,
           and strategic guidance that help organizations embrace change with confidence.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center px-10 py-5 bg-dark text-white rounded-2xl hover:bg-green hover:text-dark transition-all font-medium text-xl"
          >
            Explore how we can help
          </a>
        </div>
      </Card>
    </div>
  </div>
</MainLayout>

<style>
  .service-item:nth-child(even) {
    @apply bg-gray bg-opacity-20 py-16 -mx-4 px-4;
  }

  @media (min-width: 768px) {
    .service-item:nth-child(even) {
      @apply -mx-6 px-6;
    }
  }
</style>
