---
import MainLayout from '@/layouts/MainLayout.astro';
import Card from '@/components/ui/Card.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import type { ImageMetadata } from 'astro';

import c1 from '@/assets/pics/card-pic1.png';
import c2 from '@/assets/pics/card-pic2.png';
import c3 from '@/assets/pics/card-pic3.png';

type Service = DeepReadonly<{
  index: number;
  title: string;
  subtitle: string;
  img: ImageMetadata;
  alt: string;
  description: string;
  benefits: string[];
  cta: string;
  link: string;
}>;

const services: readonly Service[] = [
  {
    index: 1,
    title: 'Keynotes',
    subtitle: 'Ideas that move engineering teams forward',
    img: c1,
    alt: 'Keynote speaker presenting to an engineering audience',
    description:
      'Technically grounded talks for conferences, meetups, and internal events, turning real-world engineering experience into ideas your audience can act on.',
    benefits: [
      'Fresh perspectives on modern web engineering',
      'Actionable takeaways for developers and leads',
      'Topics tailored to your audience',
    ],
    cta: 'Explore keynotes',
    link: '/services/keynotes',
  },
  {
    index: 2,
    title: 'Workshops',
    subtitle: 'Learn by building, together',
    img: c2,
    alt: 'Team members collaborating during an interactive workshop',
    description:
      'Interactive, hands-on sessions with guided exercises tailored to your stack, so new skills stick and can be applied immediately.',
    benefits: [
      'Hands-on exercises based on real scenarios',
      'Shared conventions across the team',
      'Improved code quality and maintainability',
    ],
    cta: 'Explore workshops',
    link: '/services/workshops',
  },
  {
    index: 3,
    title: 'Training',
    subtitle: 'Structured programs for lasting skills',
    img: c3,
    alt: 'Engineers taking part in a technical training session',
    description:
      'Multi-session training programs that take your team from fundamentals to advanced topics, ideal for onboarding and upskilling.',
    benefits: [
      'Faster onboarding for new developers',
      'Consistent skill level across the team',
      'Confidence adopting new frameworks and tools',
    ],
    cta: 'Explore training',
    link: '/services/training',
  },
];
---

<MainLayout
  title="Services | Sign Language Tech"
  description="Expert-led keynotes, hands-on workshops, and structured technical training that help engineering teams build better web applications."
>
  <div class="pt-48 pb-24 px-4 mx-auto max-w-screen-xl lg:px-6">
    <div class="mb-16">
      <h1 class="mb-4 text-5xl font-medium leading-none tracking-tight md:text-6xl">Our Services</h1>
      <p class="text-xl font-normal leading-7 max-w-3xl">
        Helping teams and developers build better web applications through technical keynotes, hands-on workshops,
        and structured training. Whether you're upskilling your team, onboarding new developers, or bringing expert
        insights to your event, we provide tailored programs backed by real-world engineering experience.
      </p>
    </div>

    <div class="space-y-24">
      {
        services.map((service) => (
          <div class="service-item py-16 -mx-4 px-4 border border-black rounded-2xl" id={service.title.toLowerCase()}>
            <div class="mb-12">
              <ServiceCard
                index={service.index}
                title={service.title}
                description={service.subtitle}
                img={service.img}
                alt={service.alt}
                link={service.link}
              />
            </div>

            <div class="grid md:grid-cols-2 gap-10 px-4">
              <div>
                <h3 class="text-2xl font-medium mb-4">What we offer</h3>
                <p class="mb-6">{service.description}</p>
                <a
                  href={service.link}
                  class="inline-flex items-center px-8 py-4 brutal brutal-interactive rounded-2xl font-medium"
                >
                  {service.cta}
                  <svg
                    class="ml-2 w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </a>
              </div>

              <div class="bg-gray rounded-2xl p-8">
                <h3 class="text-2xl font-medium mb-4">Benefits</h3>
                <ul class="space-y-4">
                  {service.benefits.map(benefit => (
                    <li class="flex items-start">
                      <svg
                        class="mr-2 w-5 h-5 mt-1 text-black"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      <span>{benefit}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-24">
      <Card>
        <div class="p-10 md:p-16">
          <h2 class="text-3xl md:text-4xl font-medium mb-6">Learn from engineers who build, lead, and innovate</h2>
          <p class="mb-10 text-xl max-w-2xl">
            We combine deep technical expertise with real-world experience to deliver impactful keynotes, practical
            workshops, and structured training that help organizations embrace change with confidence.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center px-10 py-5 bg-dark text-white rounded-2xl hover:bg-green hover:text-dark transition-all font-medium text-xl"
          >
            Explore how we can help
          </a>
        </div>
      </Card>
    </div>
  </div>
</MainLayout>

<style>
  .service-item:nth-child(even) {
    @apply bg-gray bg-opacity-20;
  }

  @media (max-width: 1300px) {
    .service-item:nth-child(even) {
      @apply rounded-none;
    }
  }
  @media (min-width: 768px) {
    .service-item:nth-child(even) {
      @apply -mx-6 px-6;
    }
  }
</style>
